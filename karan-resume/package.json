    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "sharp": "^0.34.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.4.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^4.1.6"
  },
  "resolutions": {
    "vitest/vite": "^6.4.2"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
